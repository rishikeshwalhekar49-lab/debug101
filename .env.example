# Copy this file to .env and fill in at least one key. Never commit .env.
# Without any key the project still runs, using rules and statistics only.

# --- Groq (main provider, free tier): https://console.groq.com/keys ---
GROQ_API_KEY=

# --- Cerebras (backup provider, free tier): https://cloud.cerebras.ai ---
CEREBRAS_API_KEY=

# --- Optional: change the model for one task, as provider/model ---
# Tasks: SEMANTIC_REVIEW, DIAGNOSIS, FIX, META, PERCEPTION, VALIDATION
# SBA_MODEL_FIX=cerebras/gpt-oss-120b

# --- Optional: where the experience memory is stored (default: ~/.silent_bug_agent) ---
# SBA_HOME=
